# Copy to .env. Guest editing works even with no environment variables.
DATABASE_URL=postgres://roveran:roveran@localhost:54329/roveran
APP_ORIGIN=http://localhost:5173
PORT=3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth callback: APP_ORIGIN/api/auth/callback/google (or github)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=roveran
S3_ACCESS_KEY_ID=roveran-local
S3_SECRET_ACCESS_KEY=roveran-local-secret
S3_CREATE_BUCKET=true

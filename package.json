{
  "name": "roveran",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:parity": "node --import tsx scripts/export-parity.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "runtime:fetch": "node scripts/fetch-opencv.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "pnpm --filter @roveran/web preview"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "fake-indexeddb": "^6.2.4",
    "fflate": "^0.8.2",
    "idb": "^8.0.3"
  },
  "type": "module",
  "license": "Apache-2.0",
  "version": "0.2.0"
}

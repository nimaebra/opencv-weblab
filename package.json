{
  "name": "roveran",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:parity": "pnpm --filter @roveran/api exec node --import tsx ../../scripts/export-parity.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "runtime:fetch": "node scripts/fetch-opencv.mjs",
    "db:migrate": "pnpm --filter @roveran/api db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "ROVERAN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "start": "node apps/api/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0",
    "better-auth": "1.7.14",
    "prettier": "^3.6.0"
  },
  "type": "module"
}
